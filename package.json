{
  "name": "@falcondev-oss/trpc-vue-query",
  "type": "module",
  "version": "0.5.4",
  "description": "A tRPC wrapper around '@tanstack/vue-query'",
  "license": "MIT",
  "repository": "github:falcondev-oss/trpc-vue-query",
  "bugs": {
    "url": "https://github.com/falcondev-oss/trpc-vue-query/issues"
  },
  "keywords": [
    "trpc",
    "vue-query",
    "trpc-client",
    "tanstack-query",
    "typescript"
  ],
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint --cache . && prettier --check --cache .",
    "lint:ci": "eslint --cache --cache-strategy content . && prettier --check --cache --cache-strategy content .",
    "lint:fix": "eslint --fix --cache . && prettier --write --cache .",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "prepare": "husky",
    "test": "start-server-and-test test:server http-get://localhost:3000/ping vitest",
    "test:server": "tsx ./test/trpc/index.ts"
  },
  "peerDependencies": {
    "@tanstack/vue-query": "^5.92.9",
    "@trpc/client": "^11.13.4",
    "@trpc/server": "^11.13.4",
    "vue": "^3.5.30"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@falcondev-oss/configs": "^6.0.6",
    "@tanstack/vue-query": "^5.102.2",
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0",
    "@types/ws": "^8.18.1",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "start-server-and-test": "^3.0.12",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "type-fest": "^5.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "changelogithub": {
    "extends": "gh:falcondev-it/configs/changelogithub"
  }
}
